<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uic="clr-namespace:Lib.WPF.Controls">

    <Style TargetType="{x:Type uic:RectangleColorPickerControl}">

        <Style.Resources>
            <Style x:Key="RectangleColorMainBorderStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="White" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Width" Value="20" />
            </Style>
        </Style.Resources>
        <Setter Property="HeightButton" Value="24" />
        <Setter Property="IsAvaivableOpenPopup" Value="True" />
        <Setter Property="SpacingBrushes" Value="4" /> 
        <Setter Property="WidthButton" Value="24" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate
                    TargetType="{x:Type uic:RectangleColorPickerControl}">
                    <Grid>
                        <Border
                            x:Name="PART_MainBorder"
                            Style="{StaticResource RectangleColorMainBorderStyle}" />

                        <Popup
                            x:Name="PART_Popup"
                            MaxWidth="200" MaxHeight="200"
                            PlacementTarget="{Binding ElementName=PART_MainBorder}"
                            StaysOpen="True">
                            <Border
                                Padding="5"
                                Background="White" BorderBrush="#787878"
                                BorderThickness="1" CornerRadius="6">
                                <ScrollViewer
                                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl
                                        x:Name="PART_ItemsControl"
                                        DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel
                                                    Margin="{Binding ElementName=PART_ItemsControl, Path=DataContext.SpacingBrushes}"
                                                    Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button
                                                    Width="24" Height="24"
                                                    Margin="0" Padding="0"
                                                    Background="{Binding}"
                                                    BorderThickness="0"
                                                    Command="{Binding ElementName=PART_ItemsControl, Path=DataContext.PickColorCommand}"
                                                    CommandParameter="{Binding}" >
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource Self}}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource Self}}"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>  
        
        <Style.Triggers>
            <Trigger Property="IsAvaivableOpenPopup" Value="True">
                <Setter Property="Cursor" Value="Hand" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>