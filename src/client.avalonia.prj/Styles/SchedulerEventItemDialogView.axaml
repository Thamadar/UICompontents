<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        
        xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Xaml.Behaviors.Interactivity"
        xmlns:behaviors="using:Lib.Avalonia.Behaviors"

        xmlns:d="using:Client.Avalonia.Views.Tabs.Scheduler" 
        xmlns:c="using:Lib.Avalonia.Controls" 
        xmlns:conv="using:Lib.Avalonia.Converters"
        xmlns:sys="using:System">

  <Design.PreviewWith>
   <Border Width="400"
              Height="550"
              Background="Firebrick">
      <d:SchedulerEventItemDialogView 
      Width="300"
      Height="300"
      IsOpen="True"
      x:DataType="d:SchedulerEventItemDialogViewModel"> 
      </d:SchedulerEventItemDialogView>
    </Border>
  </Design.PreviewWith>

   <Styles.Resources>

        <conv:SwitchConverter
            x:Key="IsCreateStyleConverter">
            <conv:SwitchConverter.Default>
                <sys:Boolean>False</sys:Boolean>
            </conv:SwitchConverter.Default>
            <conv:Case
                Key="{x:Static d:SchedulerEventItemDialogTypeEnum.Create}">
                <conv:Case.Value>
                    <sys:Boolean>True</sys:Boolean>
                </conv:Case.Value>
            </conv:Case>
        </conv:SwitchConverter>
         
        <conv:SwitchConverter
            x:Key="IsEditStyleConverter">
            <conv:SwitchConverter.Default>
                <sys:Boolean>False</sys:Boolean>
            </conv:SwitchConverter.Default>
            <conv:Case
                Key="{x:Static d:SchedulerEventItemDialogTypeEnum.Edit}">
                <conv:Case.Value>
                    <sys:Boolean>True</sys:Boolean>
                </conv:Case.Value>
            </conv:Case>
        </conv:SwitchConverter>
    </Styles.Resources>


    <Style Selector="d|SchedulerEventItemDialogView">  
          <Setter Property="MaxWidth" Value="350"/> 
          <Setter Property="MaxHeight" Value="500"/> 
          <Setter Property="MinWidth" Value="350"/> 
          <Setter Property="MinHeight" Value="500"/> 
        <Style Selector="^ ContentControl#PART_Header">
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid   >
                        
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>

         <Style Selector="^ ContentControl#PART_Container">
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentControl
                    x:DataType="d:SchedulerEventItemDialogViewModel"
                        Classes.create="{Binding SchedulerEventItemDialogType, Converter={StaticResource IsCreateStyleConverter}}" 
                        Classes.edit="{Binding SchedulerEventItemDialogType, Converter={StaticResource IsEditStyleConverter}}"/>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="^ ContentControl.create">
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid
                        RowDefinitions="*,auto">

                        
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="^ ContentControl.edit"> 
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid
                        RowDefinitions="*,auto"> 

                        
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style> 
    </Style>
</Styles>
