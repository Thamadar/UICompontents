<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             
             
             xmlns:local="using:Client.Avalonia.Views.Scheduler" 
             xmlns:uic="using:Lib.Avalonia.Controls" 
             x:DataType="local:SchedulerViewModel"

             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="Client.Avalonia.Views.Scheduler.SchedulerView">
  
    <Design.DataContext>
        <local:SchedulerViewModel />
    </Design.DataContext>

    <uic:SchedulerControl 
    SchedulerPeriod="Week"
    CurrentSelectedSchedulerEventItem="{Binding CurrentSelectedSchedulerEventItem}"
    ClickSchedulerCommand="{Binding Commands.ClickSchedulerEventItemCommand}"
    EditSchedulerEventItemCommand="{Binding Commands.EditSchedulerEventItemCommand}"
    CreateSchedulerEventItemCommand="{Binding Commands.CreateSchedulerEventItemCommand}"
    StartDate="{Binding StartDateTime}"
    SchedulerEventItemsObserve="{Binding SchedulerEventItemsObserve}"/>
</UserControl>
