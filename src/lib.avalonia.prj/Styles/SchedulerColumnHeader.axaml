<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uic="using:Lib.Avalonia.Controls" >
  <Design.PreviewWith>
    <Border Padding="20">
        <uic:SchedulerColumnHeader/>
    </Border>
  </Design.PreviewWith>

  <Style Selector="uic|SchedulerColumnHeader">
      <Setter Property="Template">
        <ControlTemplate>
            <Panel 
            Height="50"
            HorizontalAlignment="Stretch"> 
                <TextBlock 
                Classes="scheduler column" 
                Text="{Binding Date, Converter={StaticResource CapitalizeDateConverter}, RelativeSource={RelativeSource TemplatedParent}}"/>

                <Separator 
                Height="NaN" Width="1" 
                HorizontalAlignment="Right"
                Margin="1,0,0,0"
                Background="{TemplateBinding BorderBrush}"
                IsVisible="{Binding !IsLastItem, RelativeSource={RelativeSource TemplatedParent}}"/>
            </Panel>  
        </ControlTemplate>
      </Setter>
  </Style>
</Styles>
