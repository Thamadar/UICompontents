<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uic="using:Lib.Avalonia.Controls" >
  <Design.PreviewWith>
    <Border Padding="20">
        <uic:SchedulerRowHeader DisplayTime="00:00"/>
    </Border>
  </Design.PreviewWith>

  <Style Selector="uic|SchedulerRowHeader">
      <Setter Property="Template">
        <ControlTemplate>
            <Grid
            Width="150"
            RowDefinitions="*,1,*" ColumnDefinitions="3*,2*"> 
                <TextBlock 
                Grid.Row="0" Grid.Column="1"
                Classes="scheduler row"
                HorizontalAlignment="Center" 
                Text="{TemplateBinding DisplayTime}"/>

                <Separator 
                Grid.Row="1" Grid.Column="1"
                Height="1" Width="NaN"  
                Margin="1,0,0,0"
                Background="{TemplateBinding BorderBrush}" />

                <Separator 
                Grid.Row="2" Grid.ColumnSpan="2"
                Height="1" Width="NaN" 
                Margin="1,0,0,0"
                VerticalAlignment="Bottom"
                Background="{TemplateBinding BorderBrush}"
                IsVisible="{Binding !IsLastItem, RelativeSource={RelativeSource TemplatedParent}}"/>
            </Grid>  
        </ControlTemplate>
      </Setter>
  </Style>
</Styles>
