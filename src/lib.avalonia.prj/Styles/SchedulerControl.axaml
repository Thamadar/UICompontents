<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uic="using:Lib.Avalonia.Controls"
        xmlns:helpers="using:Lib.Avalonia.Controls.Helpers">
  <Design.PreviewWith>
    <Border Padding="20">
    <uic:SchedulerControl/>
    </Border>
  </Design.PreviewWith>

  <Style Selector="uic|SchedulerControl">
      <Setter Property="BorderBrush" Value="#ebebeb"/>
      <Setter Property="Background"  Value="#f7f8f9"/>
      <Setter Property="Template">
            <ControlTemplate>
                <Grid
                    ColumnDefinitions="auto, *" RowDefinitions="auto,*">  
                    <Panel Grid.Row="0" Grid.Column="0"> 
                        <Separator 
                        Height="NaN" Width="1" 
                        HorizontalAlignment="Right"
                        Margin="1,0,0,0"
                        Background="{TemplateBinding BorderBrush}" />

                        <Separator  
                        Height="1" Width="NaN" 
                        Margin="1,0,0,0"
                        VerticalAlignment="Bottom"
                        Background="{TemplateBinding BorderBrush}" />
                    </Panel>

                    <!-- Заголовки столбцов -->
                    <ScrollViewer
                        Name="PART_ColumnHeaderScrollViewer"
                        Grid.Column="1" Grid.Row="0"
                        HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <Border 
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0,0,0,1">
                            <StackPanel
                                Name="PART_ColumnHeadersStackPanel" 
                                Orientation="Horizontal"/>
                        </Border>
                    </ScrollViewer>

                    <!-- Заголовки строк -->
                    <ScrollViewer
                        Name="PART_RowHeaderScrollViewer"
                        Grid.Column="0" Grid.Row="1" 
                        HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                        <Border
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0,0,1,0"> 
                            <StackPanel
                                Name="PART_RowHeadersStackPanel" 
                                Orientation="Vertical"/>
                        </Border>
                    </ScrollViewer>

                    <!-- Основной контент -->
                    <ScrollViewer
                        Name="PART_ContentScrollViewer"
                        Grid.Column="1" Grid.Row="1"
                        HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <uic:SchedulerContentPanelControl
                        Background="#f7f8f9"
                            Name="PART_SchedulerContentPanelControl" />
                    </ScrollViewer> 
                </Grid>
            </ControlTemplate>
        </Setter> 
  </Style>
</Styles>
